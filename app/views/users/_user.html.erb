<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <p>
   <strong>Photo:</strong>
   <% if user.photo.attached? %>
   <%= image_tag user.photo%>
   <%end%>
  </p>

  <p>
  <strong>Photo:</strong>
  <% if user.photo.attached? %>
    <!-- リサイズ後の画像（サムネイル）を表示 -->
    <%= image_tag user.thumbnail %>
    <!-- 元の画像を表示 -->
    <%= image_tag user.photo %>
  <% end %>
</p>

  <div>
    <strong>Age:</strong>
    <%= user.age %>
  </div>

  <div>
    <strong>Password:</strong>
    <%= user.password %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

</div>
